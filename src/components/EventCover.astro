---
import { Image } from 'astro:assets';
import type { Event } from '../lib/events';

interface Props {
  event: Event;
  widths: number[];
  sizes: string;
}

const { event, widths, sizes } = Astro.props;
const { cover, coverAlt } = event.data;
---

{
  cover ? (
    <Image src={cover} alt={coverAlt ?? ''} widths={widths} sizes={sizes} class="cover" />
  ) : (
    <div class="cover cover--placeholder" aria-hidden="true" />
  )
}

<style>
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .cover--placeholder {
    background-color: var(--color-bg-soft);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-text-on-dark) 30%, transparent) 1.1px, transparent 1.6px);
    background-size: 24px 24px;
    background-position: center;
  }
</style>
