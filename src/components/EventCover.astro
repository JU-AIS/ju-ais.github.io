---
import { Image } from 'astro:assets';
import type { Event } from '../lib/events';

interface Props {
  event: Event;
  widths: number[];
  sizes: string;
}

const { event, widths, sizes } = Astro.props;
const { cover, coverAlt, title, type } = event.data;
---

{
  cover ? (
    <Image src={cover} alt={coverAlt ?? ''} widths={widths} sizes={sizes} class="cover" />
  ) : (
    <div class="cover cover--placeholder" aria-hidden="true">
      <span class="label">{type}</span>
      <span class="cover__title">{title}</span>
    </div>
  )
}

<style>
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .cover--placeholder {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.25rem;
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-bg-dark);
  }
  .cover--placeholder .label { color: color-mix(in srgb, var(--color-text-on-dark) 60%, transparent); }
  .cover__title { font-family: var(--font-heading); font-size: 1.6rem; line-height: 1.1; }
</style>
