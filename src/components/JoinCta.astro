---
import { config } from '../config';
---

<section class="section section--dark join">
  <div class="container join__inner reveal">
    <div>
      <h2>Join {config.shortName}</h2>
      <p>Membership is open to all students at Jönköping University.</p>
    </div>
    <a href={config.joinUrl} class="btn btn--primary" target="_blank" rel="noopener">Join now</a>
  </div>
</section>

<style>
  .join__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; }
  .join h2 { margin-bottom: 0.4rem; }
  .join p { margin: 0; color: var(--color-text-muted); }
</style>
