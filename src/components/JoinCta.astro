---
import { config } from '../config';
---

<section class="section section--dark join">
  <div class="container join__inner reveal">
    <h2>Curious about AI? <em>Come build with us.</em></h2>
    <a href={config.joinUrl} class="btn btn--primary" target="_blank" rel="noopener">Join for free</a>
  </div>
</section>

<style>
  .join { background: radial-gradient(ellipse at 50% 120%, var(--color-secondary), var(--color-bg-dark) 65%); }
  .join__inner { display: grid; justify-items: center; gap: 2rem; text-align: center; }
  .join h2 { max-width: 18ch; margin: 0; }
  .join em { color: var(--color-accent); }
</style>
