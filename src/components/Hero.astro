---
import { config } from '../config';
---

<section class="hero section--dark on-dark">
  <canvas class="hero__canvas" aria-hidden="true"></canvas>
  <div class="hero__content container">
    <p class="label hero__eyebrow">Jönköping University · Student association</p>
    <h1>AI for every <em>student</em> at JU.</h1>
    <p class="hero__lead">
      We build, learn and explore AI together. Open to every programme, every school and every exchange student.
      No background needed.
    </p>
    <div class="hero__actions">
      <a href={config.joinUrl} class="btn btn--primary hero__join" target="_blank" rel="noopener">Join now</a>
      <a href={config.discordUrl} class="text-link" target="_blank" rel="noopener">Join our Discord →</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 68px);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; touch-action: pan-y; }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, var(--color-bg-dark) 0%, color-mix(in srgb, var(--color-bg-dark) 70%, transparent) 45%, transparent 75%);
  }
  .hero__content { padding-block: 5rem; }
  .hero__eyebrow { margin-bottom: 1.5rem; }
  .hero h1 { max-width: 12ch; margin-bottom: 1.5rem; }
  .hero h1 em { color: var(--color-accent); }
  .hero__lead { max-width: 34rem; font-size: clamp(1.1rem, 2.4vw, 1.3rem); opacity: 0.88; margin-bottom: 2.5rem; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2.5rem; }
  .hero__join { min-height: 56px; padding-inline: 2.2em; font-size: 1rem; }
  .hero .text-link { padding-block: 1rem; }
  .hero .text-link:hover { color: var(--color-accent); }

  @media (max-width: 720px) {
    .hero { align-items: flex-end; }
    .hero::after { background: linear-gradient(0deg, var(--color-bg-dark) 15%, color-mix(in srgb, var(--color-bg-dark) 55%, transparent) 60%, transparent 100%); }
    .hero__content { padding-block: 3rem; }
    .hero__join { width: 100%; }
  }
</style>

<script>
  import { startHeroCanvas } from '../scripts/hero-canvas';
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__canvas');
  if (canvas) startHeroCanvas(canvas);
</script>
