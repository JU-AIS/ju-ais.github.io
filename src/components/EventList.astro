---
import { render } from 'astro:content';
import EventCover from './EventCover.astro';
import { formatDate, formatTime, isPast, type Event } from '../lib/events';

interface Props {
  events: Event[];
}

const { events } = Astro.props;
const rendered = await Promise.all(
  events.map(async (event) => ({ event, past: isPast(event), Content: (await render(event)).Content })),
);
---

<ul class={events.length === 1 ? "events events--single" : "events"}>
  {
    rendered.map(({ event, past }) => (
      <li class="event-card reveal">
        <a href={`#${event.id}`} class="event-card__link" aria-haspopup="dialog">
          <EventCover event={event} widths={[400, 800, 1200, 1600]} sizes={events.length === 1 ? '(min-width: 760px) 60vw, 100vw' : '(min-width: 900px) 360px, 100vw'} />
          <div class="event-card__body">
            <p class="label">
              <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
            </p>
            <h3>{event.data.title}</h3>
            <p class="event-card__meta">{event.data.location}</p>
            <span class="event-card__more">{past ? 'See recap' : 'Details & sign-up'} →</span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

{
  rendered.map(({ event, past, Content }) => (
    <dialog id={event.id} class="event-modal" aria-labelledby={`${event.id}-title`}>
      <div class="event-modal__panel">
        <button class="event-modal__close" aria-label="Close" data-close>
          ×
        </button>
        <EventCover event={event} widths={[640, 1200, 1600]} sizes="(min-width: 760px) 720px, 100vw" />
        <div class="event-modal__body">
          <p class="label">{event.data.type}{past && ' · Past event'}</p>
          <h2 id={`${event.id}-title`}>{event.data.title}</h2>
          <dl class="event-modal__details">
            <div>
              <dt class="label">Date</dt>
              <dd>{formatDate(event.data.date)}</dd>
            </div>
            <div>
              <dt class="label">Time</dt>
              <dd>{formatTime(event.data.date)}</dd>
            </div>
            <div>
              <dt class="label">Where</dt>
              <dd>{event.data.location}</dd>
            </div>
          </dl>
          <div class="event-modal__content">
            <Content />
          </div>
          {event.data.photos && (
            <div class="event-modal__photos">
              {event.data.photos.map((photo) => (
                <img src={photo.src} width={photo.width} height={photo.height} alt="" loading="lazy" />
              ))}
            </div>
          )}
          {!past && event.data.signup && (
            <a href={event.data.signup} class="btn btn--primary" target="_blank" rel="noopener">
              Sign up
            </a>
          )}
        </div>
      </div>
    </dialog>
  ))
}

<style>
  .events { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .event-card { border-radius: var(--radius-lg); overflow: hidden; background: var(--color-bg-soft); border: 1px solid var(--color-line); transition: border-color 0.2s ease; }
  .event-card:hover { border-color: var(--color-line-hover); }
  .event-card__link { display: block; height: 100%; text-decoration: none; }
  .event-card__body { padding: 1.4rem 1.4rem 1.6rem; }
  @media (min-width: 760px) {
    .events--single { grid-template-columns: 1fr; }
    .events--single .event-card__link { display: grid; grid-template-columns: 3fr 2fr; }
    .events--single .event-card__link > :first-child { height: 100%; }
    .events--single .event-card__body { align-self: center; padding: 2.5rem; }
    .events--single h3 { font-size: 2rem; }
  }
  .event-card__body .label { margin-bottom: 0.5rem; }
  .event-card__body h3 { margin-bottom: 0.25rem; }
  .event-card__meta { color: var(--color-text-muted); margin-bottom: 1.1rem; }
  .event-card__more { font-family: var(--font-mono); font-size: var(--text-mono-sm); color: var(--color-accent); }

  .event-modal {
    width: min(720px, 100% - 1.5rem);
    max-height: calc(100% - 1.5rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    color: var(--color-text);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .event-modal::backdrop { background: var(--color-overlay); backdrop-filter: blur(6px); }
  .event-modal[open] { animation: modal-in 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .event-modal__panel { position: relative; }
  .event-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--color-overlay);
    color: var(--color-text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .event-modal :global(.cover--placeholder) { aspect-ratio: 16 / 7; }
  .event-modal__body { padding: 1.75rem clamp(1.25rem, 4vw, 2.5rem) 2.25rem; }
  .event-modal__details { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin: 1.25rem 0 1.5rem; padding: 1rem 0; border-block: 1px solid var(--color-line); }
  .event-modal__details dd { margin: 0.2rem 0 0; }
  .event-modal__content { margin-bottom: 1.75rem; }
  .event-modal__photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.5rem; margin-bottom: 1.75rem; }
  .event-modal__photos img { border-radius: var(--radius-sm); aspect-ratio: 1; object-fit: cover; }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-modal[open] { animation: none; }
    .event-card { transition: none; }
  }
</style>

<script>
  function openFromHash(): void {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const dialog = document.getElementById(id);
    if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
  }

  document.querySelectorAll<HTMLDialogElement>('dialog.event-modal').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.closest('[data-close]')) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (location.hash === `#${dialog.id}`) history.replaceState(null, '', location.pathname + location.search);
    });
  });

  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>
