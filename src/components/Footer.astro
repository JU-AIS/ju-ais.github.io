---
import { config } from '../config';
import SocialLinks from './SocialLinks.astro';
import { qrPathFor } from '../lib/pages';
const year = new Date().getFullYear();
---

<footer class="footer section--dark">
  <div class="container footer__inner">
    <div class="footer__brand">
      <img src="/logo-dark.svg" alt="" width="44" height="44" />
      <p>{config.name}</p>
    </div>
    <nav class="footer__links" aria-label="Footer">
      <SocialLinks footer qrHref={qrPathFor(Astro.url.pathname)} />
    </nav>
    <p class="footer__copy">© {year} {config.name}</p>
  </div>
</footer>

<style>
  .footer { padding-block: 3.5rem 2.5rem; border-top: 1px solid var(--color-line); }
  .footer__inner { display: grid; gap: 1.75rem; }
  .footer__brand { display: flex; align-items: center; gap: 0.9rem; }
  .footer__brand img { border-radius: var(--radius-logo); }
  .footer__brand p { margin: 0; font-size: 1.1rem; }
  .footer__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .footer__links a, .footer__copy {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: 0.06em;
    text-underline-offset: 0.3em;
    overflow-wrap: anywhere;
  }
  .footer__links a:hover { opacity: 0.75; }
  .footer__copy { margin: 0; color: var(--color-text-muted); }
  @media (min-width: 800px) {
    .footer__inner { grid-template-columns: 1fr auto; align-items: center; }
    .footer__copy { grid-column: 1 / -1; }
  }
</style>
