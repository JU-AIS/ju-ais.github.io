---
import Layout from '../layouts/Layout.astro';
import { getNowUrl } from '../lib/events';

const url = await getNowUrl();
---

<Layout title="Now" bare>
  <p class="now">Opening… <a href={url}>Tap here</a> if nothing happens.</p>
</Layout>

<style>
  .now { min-height: 100svh; display: grid; place-content: center; padding: 1rem; text-align: center; }
</style>

<script is:inline define:vars={{ url }}>
  location.replace(url);
</script>
