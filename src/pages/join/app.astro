---
import Layout from '../../layouts/Layout.astro';
import { config } from '../../config';
---

<Layout title="Get the HiTract app" bare>
  <section class="get-app">
    <h1>Get the HiTract app</h1>
    <p>Download it, create an account, then scan the join code.</p>
    <div class="get-app__stores">
      <a href={config.appStoreUrl} class="btn btn--primary">App Store</a>
      <a href={config.googlePlayUrl} class="btn btn--primary">Google Play</a>
    </div>
  </section>
</Layout>

<style>
  .get-app { min-height: 100svh; width: min(420px, 100% - 2rem); margin-inline: auto; padding-block: clamp(3rem, 12vh, 7rem); text-align: center; }
  .get-app h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
  .get-app p { color: var(--color-text-muted); margin-bottom: 2rem; }
  .get-app__stores { display: grid; gap: 0.85rem; }
</style>

<script>
  import { appStoreFor } from '../../lib/app-store';

  const store = appStoreFor(navigator.userAgent, navigator.maxTouchPoints);
  if (store) location.replace(store);
</script>
