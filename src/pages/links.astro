---
import Layout from '../layouts/Layout.astro';
import { config } from '../config';
import SocialLinks from '../components/SocialLinks.astro';
import { formatDate, getEvents } from '../lib/events';

const { upcoming } = await getEvents();
const nextEvent = upcoming[0];

const links = [
  { label: 'Join now', href: config.joinUrl, primary: true },
  ...(nextEvent
    ? [{ label: `${nextEvent.data.title} · ${formatDate(nextEvent.data.date)}`, href: `/events#${nextEvent.id}` }]
    : []),
  { label: 'Join our Discord', href: config.discordUrl, external: true },
  { label: 'Get updates on WhatsApp', href: config.whatsappUrl, external: true },
  { label: 'Website', href: '/' },
  { label: 'For companies', href: '/partners' },
  { label: 'Email us', href: `mailto:${config.email}` },
];
---

<Layout title="Links" bare>
  <section class="links">
    <img src="/logo-dark.svg" alt="" width="88" height="88" class="links__logo" />
    <h1>{config.shortName}</h1>
    <p class="links__lead">{config.name}</p>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['btn', 'links__btn', link.primary ? 'btn--primary' : 'btn--secondary']}
              {...(link.external && { target: '_blank', rel: 'noopener' })}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="links__social">
      <SocialLinks qrHref="/links/qr" />
    </div>
  </section>
</Layout>

<style>
  .links {
    min-height: 100svh;
    width: min(480px, 100% - 2rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 10vh, 6rem) 3rem;
    text-align: center;
  }
  .links__logo { margin: 0 auto 1.25rem; border-radius: var(--radius-logo); }
  .links h1 { font-size: 2.4rem; margin-bottom: 0.25rem; }
  .links__lead { color: var(--color-text-muted); margin-bottom: 2.25rem; }
  .links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .links__btn { display: flex; padding-inline: 1.25rem; }
  .links__social { display: flex; justify-content: center; margin-top: 1.75rem; }
</style>
