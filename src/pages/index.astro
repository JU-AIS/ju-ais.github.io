---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import EventList from '../components/EventList.astro';
import JoinCta from '../components/JoinCta.astro';
import { getEvents } from '../lib/events';

const { upcoming } = await getEvents();
const nextEvents = upcoming.slice(0, 3);

const offers = [
  { title: 'Build events', text: 'Build nights and hackathons where you make something real with AI.' },
  { title: 'Workshops', text: 'A beginner track to get started and a builder track to go deeper.' },
  { title: 'Talks & companies', text: 'Meet people who work with AI in industry and hear how they got there.' },
  { title: 'Projects & research', text: 'Join a team on a longer project or explore AI research with others.' },
];
---

<Layout>
  <Hero nextEvent={upcoming[0]} />

  <section class="section">
    <div class="container">
      <h2 class="reveal">What we do</h2>
      <ul class="offers">
        {
          offers.map((offer) => (
            <li class="offer reveal">
              <h3>{offer.title}</h3>
              <p>{offer.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2 class="reveal">Upcoming events</h2>
        <a href="/events" class="text-link reveal">All events →</a>
      </div>
      {nextEvents.length > 0 ? <EventList events={nextEvents} /> : <p>New events are coming soon.</p>}
    </div>
  </section>

  <section class="section" id="about">
    <div class="container about">
      <h2 class="reveal">About</h2>
      <p class="about__text reveal">
        JU AIS is a student-led non-profit at Jönköping University. We grow AI literacy across all four schools and give
        students a place to build real things with AI outside the classroom: projects, research, build nights, workshops
        and talks with companies. No programming or AI background needed. Our goal is to form the next generation of AI
        builders and leaders at JU, and to bridge academia and industry along the way.
      </p>
    </div>
  </section>

  <section class="section section--soft partner-section">
    <a href="/partners" class="container partner-teaser reveal">
      <span class="partner-teaser__title">Are you a company? Partner with us</span>
      <span aria-hidden="true">→</span>
    </a>
  </section>

  <JoinCta />
</Layout>

<style>
  .offers { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 0 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .offer { padding-block: 1.5rem; border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent); }
  .offer h3 { font-size: 1.2rem; }
  .offer p { margin: 0; color: var(--color-text-muted); }

  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .section-head h2 { margin: 0; }

  .about { display: grid; gap: 1rem 4rem; }
  .about__text { max-width: 44rem; font-size: clamp(1.15rem, 2.2vw, 1.35rem); line-height: 1.6; margin: 0; }
  @media (min-width: 900px) {
    .about { grid-template-columns: 14rem 1fr; }
  }

  .partner-section { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .partner-teaser {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    line-height: 1.2;
  }
  .partner-teaser:hover .partner-teaser__title { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
</style>
