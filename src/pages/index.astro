---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import EventList from '../components/EventList.astro';
import JoinCta from '../components/JoinCta.astro';
import { getEvents } from '../lib/events';

const { upcoming } = await getEvents();
const nextEvents = upcoming.slice(0, 3);

const pitches = [
  { title: 'Build things', text: 'Build nights, hackathons, workshops and projects. Learn AI by making something real.', href: '/what-we-do', link: 'What we do' },
  { title: 'For everyone at JU', text: 'All four schools, every programme and exchange students. No background needed.', href: '/about', link: 'About us' },
  { title: 'Meet the industry', text: 'Talks and events with companies that work with AI every day.', href: '/partners', link: 'For companies' },
];
---

<Layout>
  <Hero nextEvent={upcoming[0]} />

  <section class="section">
    <ul class="container pitches">
      {
        pitches.map((pitch) => (
          <li class="reveal">
            <a href={pitch.href} class="pitch">
              <h2>{pitch.title}</h2>
              <p>{pitch.text}</p>
              <span class="text-link">{pitch.link} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="reveal">Upcoming events</h2>
        <a href="/events" class="text-link reveal">All events →</a>
      </div>
      {nextEvents.length > 0 ? <EventList events={nextEvents} /> : <p>New events are coming soon.</p>}
    </div>
  </section>

  <JoinCta />
</Layout>

<style>
  .pitches { list-style: none; padding: 0; display: grid; gap: 0 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .pitch { display: block; height: 100%; padding-block: 1.75rem; border-top: 1px solid color-mix(in srgb, var(--color-text) 24%, transparent); text-decoration: none; transition: border-color 0.2s ease; }
  .pitch:hover { border-color: var(--color-text); }
  .pitch h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); }
  .pitch p { color: var(--color-text-muted); }
  .pitch .text-link { text-decoration: underline; }

  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .section-head h2 { margin: 0; }
</style>
